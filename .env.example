# InvoiceFlow environment variables (local development)
# Copy to .env and fill in values. Never commit .env.
# Production values are documented in docs/14-deployment-ops.md.

# --- Core (Django) ---
APP_ENV=local
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=            # 50+ random characters; also signs JWTs
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
APP_BASE_URL=http://localhost:3100
API_BASE_URL=http://localhost:8100
DATABASE_URL=postgres://invoiceflow:invoiceflow@localhost:5435/invoiceflow
REDIS_URL=redis://localhost:6380/0
FIELD_ENCRYPTION_KEY=         # base64-encoded 32 random bytes (bank details, ERP keys)
CORS_ORIGINS=http://localhost:3100

# --- Object storage (SeaweedFS S3 locally, Cloudflare R2 in production) ---
S3_ENDPOINT=http://localhost:9100
S3_BUCKET=invoiceflow-dev
S3_ACCESS_KEY_ID=invoiceflow
S3_SECRET_ACCESS_KEY=invoiceflow-dev-secret

# --- Email (Mailpit locally) ---
MAIL_INBOUND=mailpit          # mailpit | imap
MAILPIT_URL=http://localhost:8026
EMAIL_URL=smtp://localhost:1026

# --- ERP (Odoo in infra/docker-compose.yml) ---
ODOO_URL=http://localhost:8069
ODOO_DB=invoiceflow
ODOO_ADMIN_PASSWORD=          # master/admin password for the local Odoo (seed script only)
ODOO_API_USER=ap-bot@indus-retail.test
ODOO_API_KEY=                 # printed by infra/odoo/seed.py; the app's least-privilege user

# --- AI ---
LLM_PROVIDER=fake             # fake (offline) | gemini (free tier: synthetic invoices only) | claude
GEMINI_MODELS=gemini-3.6-flash,gemini-3.5-flash  # tried in order
GEMINI_API_KEYS=               # comma-separated; rotated when one hits the free-tier limit
LLM_CACHE_DIR=                 # e.g. services/core/media/llm-cache: identical pages never cost a request twice
ANTHROPIC_API_KEY=
AI_MONTHLY_BUDGET_USD=5

# --- Demo users (manage.py seed_demo) ---
DEMO_PASSWORD=                # 10+ characters

# --- Dashboard (apps/web) ---
INVOICEFLOW_API_URL=http://localhost:8100   # where the dashboard server reaches the API

# --- Observability (optional locally) ---
SENTRY_DSN_API=
