{% import "_parts.html.j2" as parts %}
<!doctype html><html><head><meta charset="utf-8"><style>
  body { font-family: Arial, sans-serif; margin: 30px; font-size: 12.5px; }
  .hdr { display: flex; justify-content: space-between; background: #1e3a8a; color: #fff; padding: 14px 18px; }
  h1 { margin: 0; font-size: 20px; } .boxes { display: flex; gap: 10px; margin: 14px 0; }
  .boxes div { flex: 1; border: 1px solid #1e3a8a; padding: 8px; } .k { font-size: 10.5px; color: #1e3a8a; font-weight: bold; }
  table { width: 100%; border-collapse: collapse; } th { background: #dbeafe; text-align: left; padding: 6px; }
  td { padding: 6px; border-bottom: 1px solid #ddd; } .num { text-align: right; }
  .pay { margin-top: 14px; border: 2px solid #1e3a8a; padding: 10px; font-size: 15px; font-weight: bold; }
  .bank, .note { font-size: 12px; }
</style></head><body>
<div class="hdr"><div><h1>{{ inv.vendor.name }}</h1>{{ inv.vendor.address }} · {{ inv.vendor.email }}</div>
  <div style="text-align:right">{{ inv.title }}<br>NTN {{ inv.vendor.tax_id }}</div></div>
<div class="boxes">
  <div><div class="k">CONSUMER</div>{{ inv.buyer.name }}<br>{{ inv.buyer.address }}</div>
  <div><div class="k">BILL NO.</div>{{ inv.invoice_number }}</div>
  <div><div class="k">ISSUE DATE</div>{{ date(inv.invoice_date) }}</div>
  {% if inv.due_date %}<div><div class="k">DUE DATE</div>{{ date(inv.due_date) }}</div>{% endif %}
</div>
<table>
  <tr><th>Charges</th><th class="num">Qty</th><th class="num">Rate</th><th class="num">Amount</th></tr>
  {% for line in inv.lines %}
  <tr><td>{{ line.description }}</td><td class="num">{{ qty(line.quantity) }}</td><td class="num">{{ money(line.unit_price) }}</td><td class="num">{{ money(line.total) }}</td></tr>
  {% endfor %}
  <tr><td colspan="3" class="num">Current charges</td><td class="num">{{ money(inv.subtotal) }}</td></tr>
  <tr><td colspan="3" class="num">Taxes ({{ pct(inv.tax_rate) }})</td><td class="num">{{ money(inv.tax_total) }}</td></tr>
</table>
<div class="pay">Amount payable{% if inv.due_date %} within due date{% endif %}: {{ money(inv.total) }}</div>
{{ parts.notes(inv) }}
{{ parts.bank(inv, shows) }}
{{ parts.second_page(inv, shows) }}
</body></html>
